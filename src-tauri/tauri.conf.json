{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Discord Status Manager",
  "version": "0.1.0",
  "identifier": "com.discordstatusmanager.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Discord Status Manager",
        "width": 860,
        "height": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
